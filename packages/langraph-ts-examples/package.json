{
  "name": "langraph-ts-examples",
  "version": "1.0.0",
  "description": "LangGraph TypeScript examples",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "node": "node --experimental-strip-types --no-warnings=ExperimentalWarning",
    "build": "tsc",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "langgraph",
    "langchain",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^1.0.2",
    "@langchain/langgraph": "^1.0.1",
    "@langchain/openai": "^0.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
